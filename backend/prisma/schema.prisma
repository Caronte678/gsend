
// GSend — Prisma schema (derivado del DDL de Fase 3 v2)
// Ejecutar: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario     Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(150)
  password_hash  String   @db.VarChar(255)
  fecha_creacion DateTime @default(now())

  @@map("usuarios")
}

model Material {
  id_material           Int      @id @default(autoincrement())
  nombre                String   @unique @db.VarChar(150)
  unidad_medida         String   @db.VarChar(30)
  stock_actual          Decimal  @default(0) @db.Decimal(12, 2)
  stock_minimo          Decimal  @default(0) @db.Decimal(12, 2)
  costo_unitario_actual Decimal  @default(0) @db.Decimal(12, 2)
  activo                Boolean  @default(true)

  recetas               ProductoMaterial[]
  reglasAtributo        AtributoMaterial[]
  movimientos           MovimientoInventario[]

  @@map("materiales")
}

model Producto {
  id_producto  Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(150)
  tipo         String   @db.VarChar(50)
  descripcion  String?
  precio_base  Decimal? @db.Decimal(12, 2)
  activo       Boolean  @default(true)

  receta       ProductoMaterial[]
  atributos    AtributoVariable[]
  items        ItemPedido[]

  @@map("productos")
}

model ProductoMaterial {
  id_producto         Int
  id_material         Int
  cantidad_por_unidad Decimal @db.Decimal(12, 4)

  producto Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  material Material @relation(fields: [id_material], references: [id_material], onDelete: Restrict)

  @@id([id_producto, id_material])
  @@map("producto_material")
}

model AtributoVariable {
  id_atributo Int      @id @default(autoincrement())
  id_producto Int
  nombre      String   @db.VarChar(100)
  tipo_dato   String   @db.VarChar(20) // 'numero' | 'texto' | 'seleccion'

  producto    Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  reglas      AtributoMaterial[]
  valores     ItemAtributoValor[]

  @@unique([id_producto, nombre])
  @@map("atributos_variables")
}

model AtributoMaterial {
  id_atributo                  Int
  id_material                  Int
  cantidad_por_unidad_atributo Decimal @db.Decimal(12, 4)

  atributo AtributoVariable @relation(fields: [id_atributo], references: [id_atributo], onDelete: Cascade)
  material Material         @relation(fields: [id_material], references: [id_material], onDelete: Restrict)

  @@id([id_atributo, id_material])
  @@map("atributo_material")
}

model Pedido {
  id_pedido        Int      @id @default(autoincrement())
  fecha_creacion   DateTime @default(now())
  estado           String   @default("pendiente") @db.VarChar(20) // pendiente | confirmado | completado | cancelado
  cliente_nombre   String   @db.VarChar(150)
  cliente_contacto String?  @db.VarChar(150)
  notas            String?

  items        ItemPedido[]
  movimientos  MovimientoInventario[]
  pagos        Pago[]

  @@map("pedidos")
}

model ItemPedido {
  id_item               Int      @id @default(autoincrement())
  id_pedido             Int
  id_producto            Int
  cantidad               Int
  precio_venta_unitario  Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  producto Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Restrict)
  valores  ItemAtributoValor[]

  @@map("items_pedido")
}

model ItemAtributoValor {
  id_valor    Int    @id @default(autoincrement())
  id_item     Int
  id_atributo Int
  valor       String @db.VarChar(150)

  item     ItemPedido       @relation(fields: [id_item], references: [id_item], onDelete: Cascade)
  atributo AtributoVariable @relation(fields: [id_atributo], references: [id_atributo], onDelete: Restrict)

  @@unique([id_item, id_atributo])
  @@map("item_atributo_valor")
}

model MovimientoInventario {
  id_movimiento  Int      @id @default(autoincrement())
  id_material    Int
  tipo           String   @db.VarChar(10) // 'entrada' | 'salida'
  cantidad       Decimal  @db.Decimal(12, 2)
  costo_unitario Decimal? @db.Decimal(12, 2)
  fecha          DateTime @default(now())
  id_pedido      Int?
  motivo         String?  @db.VarChar(200)

  material Material @relation(fields: [id_material], references: [id_material], onDelete: Restrict)
  pedido   Pedido?  @relation(fields: [id_pedido], references: [id_pedido], onDelete: SetNull)

  @@map("movimientos_inventario")
}

model Pago {
  id_pago     Int      @id @default(autoincrement())
  id_pedido   Int
  monto       Decimal  @db.Decimal(12, 2)
  fecha       DateTime @default(now())
  metodo_pago String?  @db.VarChar(50)

  pedido Pedido @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)

  @@map("pagos")
}

// Configuración de la pyme (nombre, logo, descripción) como pares clave/valor.
// Creada por la migración 20260820164549_add_configuracion.
model Configuracion {
  clave String  @id @db.VarChar(100)
  valor String?

  @@map("configuracion")
}
