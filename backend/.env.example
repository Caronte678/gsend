# ─── Base de datos ───────────────────────────────────────────────────────────
# Local:      postgresql://usuario:password@localhost:5432/gsend?schema=public
# Producción: la cadena que te da el proveedor (Neon, Supabase, Render…).
#             Suele requerir SSL: agregá ?sslmode=require al final.
DATABASE_URL="postgresql://usuario:password@localhost:5432/gsend?schema=public"

# ─── Sesión ──────────────────────────────────────────────────────────────────
# Generá uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En producción se rechaza el arranque si tiene menos de 32 caracteres.
JWT_SECRET="cambia-este-valor-por-uno-seguro-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="8h"

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=4000
# En producción poner NODE_ENV=production: activa el rate limit por IP real,
# la validación del secreto y el servido del frontend compilado.
# NODE_ENV=production

# ─── Opcionales ──────────────────────────────────────────────────────────────
# Solo si el frontend se sirve desde otro dominio (no hace falta en el
# despliegue de un solo servicio). Separar varios con comas.
# CORS_ORIGIN="https://gsend.tudominio.com"

# Ruta al frontend compilado si no está en ../frontend/dist
# FRONTEND_DIST="/ruta/a/dist"
